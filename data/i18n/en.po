msgid "Cão Protetor"
msgstr "Protector Dog"

#. classes.0.Species
msgid "Cão"
msgstr "Dog"

#. classes.0.Role
#. classes.0.Description
msgid "Tanque e Proteção"
msgstr "Tank and Protection"

